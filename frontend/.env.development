# Loaded by `vue-cli-service serve` (development mode) only — never by the production
# build, which has VUE_APP_API_ENDPOINT injected by the CDK website stack. So this points
# the local frontend at the local dev API server (`npm run dev:api` in the repo root).
#
# To instead point `npm run serve` at the deployed Dev API, create frontend/.env.development.local
# (gitignored) with e.g. VUE_APP_API_ENDPOINT=https://dev.api.evanheaton.com
VUE_APP_API_ENDPOINT=http://localhost:3000
